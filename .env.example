# Copy to .env.local for local dev.
# For production on Vercel, set these in Project Settings > Environment Variables.

# Supabase (free tier) — enables persistent memory across serverless calls.
# Create a project, run the SQL in db/schema.sql, then:
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Without these vars, the app runs with in-memory memory (resets on restart) —
# fine for a quick demo, but Supabase makes it persistent.
