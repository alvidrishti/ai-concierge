# Copy to .env.local for local dev.
# For production on Vercel, set these in Project Settings > Environment Variables.

# --- Supabase (persistent memory) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- WhatsApp (Twilio) — optional, for WhatsApp integration ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=+1...   # Twilio WhatsApp sandbox/number

# --- Stripe (billing) — optional, for subscription plans ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Without these, the app runs with in-memory memory (resets on restart) and
# WhatsApp/billing are disabled — fine for a web demo.
