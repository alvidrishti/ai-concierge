# MAN — Personal AI Intelligence Agent
# Copy to .env.local for local dev. Set in Vercel > Project Settings > Env Vars for production.
# NEVER commit real keys.

# ---- AI providers (priority: Gemini -> Groq -> DeepSeek -> OpenRouter -> GitHub Models) ----
GEMINI_API_KEY=
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
GITHUB_TOKEN=

# ---- Supabase (multi-user memory + conversations + usage) ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Auth ----
# Long random string used to sign session tokens (e.g. `openssl rand -hex 32`)
AUTH_SECRET=change_this_to_a_long_random_string
# Admin password (creator login) — also protects /api/usage admin view
ADMIN_PASS=change_this

# ---- Social login (OAuth) — optional. Create an OAuth app in each console ----
# Google: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub: https://github.com/settings/developers (OAuth app)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Facebook: https://developers.facebook.com/apps
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
# Redirect URI (must match the OAuth app's configured redirect URI):
#   https://<your-app>.vercel.app/api/auth/oauth/callback/google
#   https://<your-app>.vercel.app/api/auth/oauth/callback/github
#   https://<your-app>.vercel.app/api/auth/oauth/callback/facebook

# ---- Rate limits (configurable, not hardcoded) ----
MAN_TEXT_DAILY=100
MAN_VOICE_MIN_DAILY=15

# ---- Optional: model overrides ----
# MAN_GEMINI_MODEL=gemini-2.0-flash
# MAN_GROQ_MODEL=llama-3.3-70b-versatile
# MAN_DEEPSEEK_MODEL=deepseek-chat
# MAN_OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ---- Optional: WhatsApp (Twilio) / Billing (Stripe) from Tether ----
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- SMS delivery (SMSBD) — for phone OTP ----
SMSBD_API_KEY=
SMSBD_SENDER_ID=
SMSBD_API_URL=https://api.smsbd.com/smsapi

# ---- Email delivery (Resend) — for forgot-password reset emails ----
RESEND_API_KEY=
EMAIL_FROM=MAN <onboarding@resend.dev>

# ---- Phase 1 account lifecycle (email verification) ----
# Email verification link uses NEXT_PUBLIC_APP_URL (set this to the deployed origin).
